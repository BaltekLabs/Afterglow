{
  "name": "Afterglow",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "CameraMaxZoomDistance": 30,
        "CameraMinZoomDistance": 4,
        "CharacterWalkSpeed": 14
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 18.25,
        "Brightness": 2,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.5,
        "EnvironmentSpecularScale": 1
      }
    }
  }
}
